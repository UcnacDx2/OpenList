+import { pathDir, r } from "~/utils"
+import { SetUpload, Upload } from "./types"
+import { calculateHash } from "./util"
+
+type DirectPart = {
+  part_number: number
+  offset: number
+  size: number
+  upload_url: string
+  method?: string
+  headers?: Record<string, string>
+}
+
+type DirectInfo = {
+  session_id?: string
+  completed: boolean
+  parts?: DirectPart[]
+}
+
+function createSpeedCalculator(throttleMs = 500) {
+  let lastLoaded = 0
+  let lastTime = Date.now()
+
+  return (loaded: number, setUpload: SetUpload) => {
+    const now = Date.now()
+    const timeDiff = (now - lastTime) / 1000
+    if (timeDiff >= throttleMs / 1000) {
+      setUpload("speed", (loaded - lastLoaded) / timeDiff)
+      lastLoaded = loaded
+      lastTime = now
+    }
+  }
+}
+
+const getDirectInfo = async (
+  path: string,
+  file: File,
+  tool: string,
+  overwrite: boolean,
+): Promise<DirectInfo> => {
+  const resp = await r.post(
+    "/fs/get_direct_upload_info",
+    {
+      path,
+      file_name: file.name,
+      file_size: file.size,
+      tool,
+    },
+    { headers: { Overwrite: overwrite } },
+  )
+  return resp.data as DirectInfo
+}
+
+export const MultipartDirectUpload: Upload = async (
+  uploadPath: string,
+  file: File,
+  setUpload: SetUpload,
+  _asTask: boolean,
+  overwrite: boolean,
+  _rapid: boolean,
+) => {
+  const path = pathDir(uploadPath)
+
+  setUpload("status", "hashing")
+  const { sha256 } = await calculateHash(file, (progress) => {
+    setUpload("progress", progress | 0)
+  })
+
+  setUpload("status", "uploading")
+  setUpload("progress", 0)
+  const info = await getDirectInfo(
+    path,
+    file,
+    `MultipartDirect:init:${sha256}`,
+    overwrite,
+  )
+  if (info.completed) {
+    setUpload("progress", 100)
+    setUpload("speed", 0)
+    return
+  }
+  if (!info.session_id || !info.parts?.length) {
+    throw new Error("Multipart Direct returned an incomplete upload session")
+  }
+
+  const parts = [...info.parts].sort((a, b) => a.part_number - b.part_number)
+  const calcSpeed = createSpeedCalculator()
+  let uploadedBytes = 0
+
+  for (const part of parts) {
+    const chunk = file.slice(
+      part.offset,
+      part.offset + part.size,
+      "application/octet-stream",
+    )
+    const xhr = new XMLHttpRequest()
+
+    await new Promise<void>((resolve, reject) => {
+      xhr.upload.addEventListener("progress", (e) => {
+        if (!e.lengthComputable) return
+        const totalLoaded = uploadedBytes + e.loaded
+        setUpload("progress", ((totalLoaded / file.size) * 100) | 0)
+        calcSpeed(totalLoaded, setUpload)
+      })
+      xhr.addEventListener("load", () => {
+        if (xhr.status >= 200 && xhr.status < 300) {
+          uploadedBytes += part.size
+          resolve()
+        } else {
+          reject(
+            new Error(
+              `Direct upload part ${part.part_number} failed with status ${xhr.status}`,
+            ),
+          )
+        }
+      })
+      xhr.addEventListener("error", () => {
+        reject(new Error(`Direct upload part ${part.part_number} failed`))
+      })
+
+      xhr.open(part.method || "PUT", part.upload_url)
+      for (const [key, value] of Object.entries(part.headers || {})) {
+        xhr.setRequestHeader(key, value)
+      }
+      xhr.send(chunk)
+    })
+  }
+
+  setUpload("status", "backending")
+  setUpload("speed", 0)
+  // Completion still goes through OpenList's normal write-permission checks.
+  // Force the conflict probe off here: the 139 create call may already expose
+  // a placeholder/auto-renamed object before /complete succeeds.
+  const completed = await getDirectInfo(
+    path,
+    file,
+    `MultipartDirect:complete:${info.session_id}`,
+    true,
+  )
+  if (!completed.completed) {
+    throw new Error("Multipart Direct completion failed")
+  }
+  setUpload("progress", 100)
+}
